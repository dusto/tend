{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "UsageCost": {
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "amount",
        "currency"
      ]
    }
  },
  "properties": {
    "session_id": {
      "type": "string"
    },
    "used_tokens": {
      "type": "integer"
    },
    "window_tokens": {
      "type": "integer"
    },
    "cost": {
      "$ref": "#/$defs/UsageCost"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "session_id",
    "used_tokens",
    "window_tokens"
  ]
}
