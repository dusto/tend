{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Diagnostic": {
      "properties": {
        "range": {
          "$ref": "#/$defs/Range"
        },
        "severity": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "range",
        "severity",
        "message"
      ]
    },
    "Position": {
      "properties": {
        "line": {
          "type": "integer"
        },
        "byte_col": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "line",
        "byte_col"
      ]
    },
    "Range": {
      "properties": {
        "start": {
          "$ref": "#/$defs/Position"
        },
        "end": {
          "$ref": "#/$defs/Position"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "start",
        "end"
      ]
    }
  },
  "properties": {
    "uri": {
      "type": "string"
    },
    "open": {
      "type": "boolean"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "uri",
    "open",
    "diagnostics"
  ]
}
