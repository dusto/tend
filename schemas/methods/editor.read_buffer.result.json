{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FileBase": {
      "properties": {
        "content_hash": {
          "type": "string"
        },
        "changedtick": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "properties": {
    "content": {
      "type": "string"
    },
    "base": {
      "$ref": "#/$defs/FileBase"
    },
    "open": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "content",
    "base",
    "open"
  ]
}
