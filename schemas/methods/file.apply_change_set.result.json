{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FileBase": {
      "properties": {
        "content_hash": {
          "type": "string"
        },
        "changedtick": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "FileChangeOutcome": {
      "properties": {
        "uri": {
          "type": "string"
        },
        "applied": {
          "type": "boolean"
        },
        "base": {
          "$ref": "#/$defs/FileBase"
        },
        "rolled_back": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "uri",
        "applied"
      ]
    }
  },
  "properties": {
    "change_set_id": {
      "type": "string"
    },
    "applied": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/FileChangeOutcome"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "change_set_id",
    "applied",
    "files"
  ]
}
