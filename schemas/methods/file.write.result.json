{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FileBase": {
      "properties": {
        "content_hash": {
          "type": "string"
        },
        "changedtick": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "properties": {
    "change_set_id": {
      "type": "string"
    },
    "applied": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "base": {
      "$ref": "#/$defs/FileBase"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "change_set_id",
    "applied"
  ]
}
