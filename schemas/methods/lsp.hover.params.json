{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Position": {
      "properties": {
        "line": {
          "type": "integer"
        },
        "byte_col": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "line",
        "byte_col"
      ]
    }
  },
  "properties": {
    "session_id": {
      "type": "string"
    },
    "uri": {
      "type": "string"
    },
    "position": {
      "$ref": "#/$defs/Position"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "session_id",
    "position"
  ]
}
