{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SessionInfo": {
      "properties": {
        "session_id": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/TaskRef"
        },
        "worktree_root": {
          "type": "string"
        },
        "stream_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "pending": {
          "$ref": "#/$defs/SessionPending"
        },
        "editor_bound": {
          "type": "boolean"
        },
        "current_mode_id": {
          "type": "string"
        },
        "available_modes": {
          "items": {
            "$ref": "#/$defs/SessionMode"
          },
          "type": "array"
        },
        "current_model_id": {
          "type": "string"
        },
        "available_models": {
          "items": {
            "$ref": "#/$defs/SessionModel"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "session_id",
        "provider_id",
        "workspace_id",
        "worktree_root",
        "stream_id",
        "status",
        "editor_bound"
      ]
    },
    "SessionMode": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name"
      ]
    },
    "SessionModel": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name"
      ]
    },
    "SessionPending": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "id"
      ]
    },
    "TaskRef": {
      "properties": {
        "provider": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "provider",
        "workspace_id",
        "id"
      ]
    }
  },
  "properties": {
    "sessions": {
      "items": {
        "$ref": "#/$defs/SessionInfo"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "sessions"
  ]
}
