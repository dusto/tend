{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SlashCommand": {
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "arg_hint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "origin"
      ]
    }
  },
  "properties": {
    "commands": {
      "items": {
        "$ref": "#/$defs/SlashCommand"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "commands"
  ]
}
