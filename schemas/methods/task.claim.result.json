{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "TaskComment": {
      "properties": {
        "author": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "text",
        "at"
      ]
    },
    "TaskRef": {
      "properties": {
        "provider": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "provider",
        "workspace_id",
        "id"
      ]
    }
  },
  "properties": {
    "ref": {
      "$ref": "#/$defs/TaskRef"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "assignee": {
      "type": "string"
    },
    "labels": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "comments": {
      "items": {
        "$ref": "#/$defs/TaskComment"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "ref",
    "title",
    "status"
  ]
}
