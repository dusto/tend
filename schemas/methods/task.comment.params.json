{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "TaskRef": {
      "properties": {
        "provider": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "provider",
        "workspace_id",
        "id"
      ]
    }
  },
  "properties": {
    "ref": {
      "$ref": "#/$defs/TaskRef"
    },
    "text": {
      "type": "string"
    },
    "author": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "ref",
    "text"
  ]
}
